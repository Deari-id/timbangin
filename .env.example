# Server-only AI key for Vercel API routes. Never expose with a VITE_ prefix.
GEMINI_API_KEY=

# Optional comma-separated production/staging hosts allowed to call /api/ai.
# Defaults already include timbangin.id, www.timbangin.id, timbangin.vercel.app, localhost, and *.vercel.app previews.
AI_ALLOWED_REFERRER=

# Optional model override.
SUMOPOD_MODEL=gemini-3-flash-preview
